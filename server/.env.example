# ---------- Provedor de LLM ----------
# Provedor principal: claude | deepseek | openai_mini | ollama
SHOGUN_LLM_PROVIDER=claude
# Provedor acionado quando o principal falha. Vazio = sem fallback.
SHOGUN_LLM_FALLBACK_PROVIDER=
#
# Uso local sem custo de API: rode o modelo no Ollama e deixe um provedor de
# nuvem como rede de seguranca para quando ele estiver fora ou devolver JSON
# que nao passa na validacao. Veja "Rodando local com Ollama" no README.
#   SHOGUN_LLM_PROVIDER=ollama
#   SHOGUN_LLM_FALLBACK_PROVIDER=deepseek
# Teto de tokens da resposta do modelo por comando (inclui os tokens de
# raciocinio nos modelos com thinking adaptativo)
SHOGUN_MAX_TOKENS=4096
# Timeout (segundos) das chamadas ao LLM
SHOGUN_LLM_TIMEOUT=30

# ---------- Credenciais e modelos ----------
# Anthropic (https://console.anthropic.com/)
ANTHROPIC_API_KEY=
SHOGUN_MODEL=claude-opus-5
# DeepSeek (https://platform.deepseek.com/)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
# OpenAI (https://platform.openai.com/)
OPENAI_API_KEY=
OPENAI_MINI_MODEL=gpt-4o-mini
# Ollama (https://ollama.com/) — local, sem credencial.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=hermes3:8b

# ---------- Autenticação ----------
# Token fixo exigido dos clientes no header `Authorization: Bearer <token>`.
# Vazio = autenticação desligada (apenas desenvolvimento local).
SHOGUN_AUTH_TOKEN=

# ---------- Servidor ----------
SHOGUN_HOST=0.0.0.0
SHOGUN_PORT=8000
