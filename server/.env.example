# ---------- Provedor de LLM ----------
# Provedor principal: claude | deepseek | openai_mini | ollama
SHOGUN_LLM_PROVIDER=claude
# Provedor acionado quando o principal falha. Vazio = sem fallback.
SHOGUN_LLM_FALLBACK_PROVIDER=
#
# Uso local sem custo de API: rode o modelo no Ollama e deixe um provedor de
# nuvem como rede de seguranca para quando ele estiver fora ou devolver JSON
# que nao passa na validacao. Veja "Rodando local com Ollama" no README.
#   SHOGUN_LLM_PROVIDER=ollama
#   SHOGUN_LLM_FALLBACK_PROVIDER=deepseek
# Teto de tokens da resposta do modelo por comando (inclui os tokens de
# raciocinio nos modelos com thinking adaptativo)
SHOGUN_MAX_TOKENS=4096
# Timeout (segundos) das chamadas ao LLM
SHOGUN_LLM_TIMEOUT=30

# ---------- Credenciais e modelos ----------
# Anthropic (https://console.anthropic.com/)
ANTHROPIC_API_KEY=
SHOGUN_MODEL=claude-opus-5
# DeepSeek (https://platform.deepseek.com/)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
# OpenAI (https://platform.openai.com/)
OPENAI_API_KEY=
OPENAI_MINI_MODEL=gpt-4o-mini
# Ollama (https://ollama.com/) — local, sem credencial.
# OLLAMA_MODEL e OBRIGATORIA quando o provedor 'ollama' e o principal ou o
# fallback: nao ha modelo padrao no codigo, e o servidor recusa subir sem ela.
# Escolha um modelo na secao "Modelos candidatos" do server/README.md — ela
# compara VRAM contra aderencia ao ESQUEMA_COMANDO. Ex.: qwen2.5:7b-instruct.
# Com outro provedor, deixe vazia: ela nao e lida.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=

# ---------- Autenticação ----------
# Token fixo exigido dos clientes no header `Authorization: Bearer <token>`.
# Vazio = autenticacao desligada, e SO e aceito quando o bind e local
# (127.0.0.1, localhost, ::1). Com qualquer outro host o servidor RECUSA SUBIR:
# escutar na rede sem token deixaria o Shogun aberto a quem alcancasse a porta.
# A checagem olha o bind real do uvicorn, nao esta variavel: passar
# `uvicorn --host 0.0.0.0` na linha de comando e barrado do mesmo jeito.
SHOGUN_AUTH_TOKEN=

# ---------- Servidor ----------
# 0.0.0.0 escuta em todas as interfaces — necessario para o mobile alcancar o
# servidor via Tailscale. Exige SHOGUN_AUTH_TOKEN preenchido (ver acima).
# Para desenvolvimento local sem token, use 127.0.0.1.
SHOGUN_HOST=0.0.0.0
SHOGUN_PORT=8000

# ---------- Acesso remoto / CORS ----------
# Origens permitidas no CORS, separadas por virgula. Vazio = CORS desligado.
#
# Os clientes de hoje NAO precisam disso: desktop (Tauri) e mobile (React
# Native) falam HTTP direto, sem origem de navegador. Preencha so quando houver
# cliente rodando em navegador — ai inclua o IP Tailscale desta maquina, que e
# por onde o mobile chega. Descubra o seu com `tailscale ip -4`; o valor abaixo
# e so exemplo.
#
#   SHOGUN_ALLOWED_ORIGINS=http://100.101.102.103:8000,http://localhost:1420
#
# Ver "Acesso remoto via Tailscale" no server/README.md.
SHOGUN_ALLOWED_ORIGINS=
