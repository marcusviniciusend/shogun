# Chave da API da Anthropic (https://console.anthropic.com/)
ANTHROPIC_API_KEY=
# Modelo padrão usado pelo Shogun
SHOGUN_MODEL=claude-opus-5
# Teto de tokens da resposta do modelo por comando
SHOGUN_MAX_TOKENS=2048
# Token fixo exigido dos clientes no header `Authorization: Bearer <token>`.
# Vazio = autenticação desligada (apenas desenvolvimento local).
SHOGUN_AUTH_TOKEN=
# Host/porta do servidor
SHOGUN_HOST=0.0.0.0
SHOGUN_PORT=8000
